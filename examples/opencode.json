{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible server",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "tools": true
        }
      }
    }
  },
  "model": "local/qwen3.6:35b-a3b",
  "mcp": {
    "acte": {
      "type": "local",
      "command": ["acte", "serve", "acte-graph.ttl"],
      "enabled": true
    }
  },
  "permission": {
    "bash": "deny",
    "edit": "deny",
    "task": "deny",
    "todowrite": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "acte_*": "allow"
  }
}
